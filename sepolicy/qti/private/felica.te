# The NFC module ships a FeliCa backend for the japanese models
# (packages/modules/Nfc/NfcNci/src/jp/project2by2/felica). It registers
# jp.project2by2.felica.IFelica/default from the nfc domain, and AOSP has no
# service_contexts entry for it, so the registration is denied:
#
#   avc: denied { add } for name=jp.project2by2.felica.IFelica/default
#        scontext=u:r:nfc:s0 tcontext=u:object_r:default_android_service:s0
#
# app_api_service so that the Mobile FeliCa Client, an ordinary app in
# /product/app, can reach it.
type felica_service, app_api_service, service_manager_type;

allow nfc felica_service:service_manager { add find };
